if [ -n "$AUDIT_MODE" ]; then
    SUDO_RUNNER="${SUDO_USER:-root}"
    SUDO_RUNNER_HOME=$(getent passwd "$SUDO_RUNNER" | cut -d: -f6)
    [ -z "$SUDO_RUNNER_HOME" ] && SUDO_RUNNER_HOME="/home/${SUDO_RUNNER:-root}"
    DATE_STR=$(date +"%SS%MM%HH—%d-%m-%Y")
    DEFAULT_FILE_NAME="${SUDO_RUNNER}-${TYPE}_${DATE_STR}.txt"
