# Global Cleanup Handler
# Split in two so signal handlers can tear down the daemons without deleting
# $PAYLOAD: a Ctrl+C at the selection prompt must not remove the rcfile the
# session shell is about to read. $PAYLOAD removal stays on EXIT only.
cleanup_watchdogs() {
    # Reap each daemon's children BEFORE the daemon itself: once the parent
    # dies, the kernel reparents the children and pkill -P would miss them.
    if [ -n "$WATCHDOG_PID" ]; then
        pkill -P "$WATCHDOG_PID" 2>/dev/null
        kill "$WATCHDOG_PID" 2>/dev/null
    fi
    if [ -n "$WANTED_PID" ]; then
        pkill -P "$WANTED_PID" 2>/dev/null
        kill "$WANTED_PID" 2>/dev/null
    fi
}
cleanup_daemons() {
    cleanup_watchdogs
    if [ -f "$PAYLOAD" ]; then
        rm -f "$PAYLOAD"
    fi
    # A signal-path exit (SIGTERM/SIGHUP/SIGQUIT) skips the normal audit
    # processing, so drop the raw capture here too; it is unset until the
    # session-wrapper path starts.
    if [ -n "${RAW_AUDIT:-}" ]; then
        rm -f "$RAW_AUDIT"
    fi
}
trap cleanup_daemons EXIT
# The SIGINT no-op trap is registered near the top of the script (before
# the selection menu). Closing the app must end the session: on termination
# signals, tear the session down (same escalation as the watchdog) and stop.
# kill_payload is defined below; the trap string resolves it at fire time.
trap 'cleanup_watchdogs; kill_payload; exit 143' SIGTERM SIGHUP SIGQUIT

# Kill function to gracefully and forcefully terminate the session and all wrappers
kill_payload() {
    local B_PID
    # The wrapper chain (script -> sudo -> session bash) all contain the
    # payload path in their command lines; resolve the session shell itself
    # by process tree so the graceful USR1 (its payload trap runs exit 0,
    # firing any -last EXIT trap) never lands on a wrapper or a forked
    # subshell of the session.
    B_PID=$(session_shell_pid)
    
    if [ -n "$B_PID" ]; then
        kill -USR1 "$B_PID" 2>/dev/null
    fi
    pkill -USR1 -P $$ -x script 2>/dev/null
    pkill -USR1 -P $$ -x sudo 2>/dev/null
    
    sleep 0.1
    
    if [ -n "$B_PID" ]; then
        kill -INT "$B_PID" 2>/dev/null
    fi
    pkill -INT -P $$ -x script 2>/dev/null
    pkill -INT -P $$ -x sudo 2>/dev/null
    
    sleep 0.2
    
    if [ -n "$B_PID" ]; then
        kill -HUP "$B_PID" 2>/dev/null
    fi
    pkill -HUP -P $$ -x script 2>/dev/null
    pkill -HUP -P $$ -x sudo 2>/dev/null
    
    # Final Failsafe: Aggressive cleanup for daemonized ptys (e.g. GUI apps blocking EOF)
    sleep 0.5
    if [ -n "$B_PID" ]; then
        kill -9 "$B_PID" 2>/dev/null
    fi
    pkill -9 -P $$ -x script 2>/dev/null
    pkill -9 -P $$ -x sudo 2>/dev/null
}

echo "[ -f ~/.bashrc ] && source ~/.bashrc" > "$PAYLOAD"
echo "stty -echoctl" >> "$PAYLOAD"  # Hide that ^C

while IFS= read -r -d '' var; do
    V_NAME="${var%%=*}"
    # Proceed only if the variable name is valid and NOT in the read-only exclusion list
    if [[ "$V_NAME" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] && [[ ! "$V_NAME" =~ ^(UID|EUID|PPID|SHELLOPTS|BASHOPTS|PWD|OLDPWD)$ ]]; then
        # Never graft terminal-identity variables from the target session — see TERM_IDENTITY above
        for TV in "${TERM_IDENTITY_NAMES[@]}"; do
            [ "$V_NAME" == "$TV" ] && continue 2
        done
        printf "export %s=%q\n" "$V_NAME" "${var#*=}" >> "$PAYLOAD"
    fi
done < "/proc/$LEADER/environ" 2>/dev/null || true

# Re-assert the caller's terminal identity so TUI colours pass through to the client
