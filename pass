    echo "echo -e '${GREEN}Location${RESET} ${ULINE}${YELLOW}$(sq "$CUSTOM_AUDIT_PATH")${RESET} ${RED}is ${ULINE}not${RESET} ${RED}accessible${RESET}, ${CYAN}defaulting${RESET} ${CYAN}filepath${RESET} to ${GREEN}'\"$AUDIT_DIR\"'${RESET}'" >> "$PAYLOAD"
    echo "echo -e '${RED}${ULINE}Unable${RESET} ${RED}to write${RESET} ${YELLOW}$(sq "$DESIRED_AUDIT_FILE")${RESET} at ${ULINE}${YELLOW}$(sq "$DESIRED_AUDIT_DIR")${RESET}, ${CYAN}defaulting${RESET} ${CYAN}filename${RESET} to ${GREEN}${DEFAULT_FILE_NAME}${RESET}'" >> "$PAYLOAD"
elif [ "$AUDIT_NAME_CONFLICT" -eq 1 ] && [ "$SILENT" -ne 1 ]; then
    echo "if [ \"\$BP_NOTICE_SHOWN\" != \"1\" ]; then echo -e '${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${YELLOW}${BOLD}Notice${RESET}'; export BP_NOTICE_SHOWN=1; fi" >> "$PAYLOAD"
    echo "echo -e '${RED}${ULINE}Unable${RESET} ${RED}to write${RESET} ${YELLOW}$(sq "$DESIRED_AUDIT_FILE")${RESET} at ${ULINE}${YELLOW}$(sq "$DESIRED_AUDIT_DIR")${RESET}, ${CYAN}defaulting${RESET} ${CYAN}filename${RESET} to ${GREEN}${DEFAULT_FILE_NAME}${RESET}'" >> "$PAYLOAD"
