[ "$SILENT" -ne 1 ] && echo "if [ \"\$BP_ACCEPTED_SHOWN\" != \"1\" ]; then echo -e '${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${GREEN}${BOLD}Accepted${RESET}'; export BP_ACCEPTED_SHOWN=1; fi" >> "$PAYLOAD"
[ "$SILENT" -ne 1 ] && echo "echo -e '${BRIGHT_GREEN}Pass${RESET} ${GREEN}accepted${RESET} for ${ULINE}${YELLOW}$D_USER${RESET}'" >> "$PAYLOAD"

