#!/bin/bash

if [ -t 1 ]; then
    # Terminal Styling — when invoked with TERM unset, sudo sets TERM=dumb and
    # tput yields nothing; give interactive runs a sane terminal for styling.
    [ "$TERM" = "dumb" ] && TERM=xterm-256color
    RED=$(tput setaf 1)
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    BLUE=$(tput setaf 4)
    MAGENTA=$(tput setaf 5)
    CYAN=$(tput setaf 6)
    BRIGHT_RED=$(tput setaf 9)
    BRIGHT_GREEN=$(tput setaf 10)
    BRIGHT_YELLOW=$(tput setaf 11)
    BRIGHT_BLUE=$(tput setaf 12)
    BOLD=$(tput bold)
    BLINK=$(tput blink)
    ULINE=$(tput smul)
    R_ULINE=$(tput rmul)
    RESET=$(tput sgr0)
# Background-Running Chroma Purge (for better logs & integrations)
else
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    MAGENTA=""
    CYAN=""
    BRIGHT_RED=""
    BRIGHT_GREEN=""
    BRIGHT_YELLOW=""
    BRIGHT_BLUE=""
    BOLD=""
    BLINK=""
    ULINE=""
    R_ULINE=""
    RESET=""
fi

# App version (displayed by -version / --version)
VERSION="2.0"

# --- Shared feedback blocks (each emitted at most once per run) -------------
# Headers are split out from their messages so a header never prints twice
# even when several messages fire in one run. Styling per styling.md:
# title = GREEN ULINE BOLD; subtitles = BOLD (Error red, Notice yellow,
# Accepted green, Wanted yellow, Rescinded green, ...). The _SHOWN flags are
# exported so the session shell (payload) can inherit the parent's state.
export BP_ERROR_SHOWN=0 BP_NOTICE_SHOWN=0 BP_TITLE_SHOWN=0 BP_ACCEPTED_SHOWN=0 \
       BP_WANTED_SHOWN=0 BP_RESCINDED_SHOWN=0 BP_TIMER_END_SHOWN=0 BP_ASSIGN_SHOWN=0

bp_error() {   # "Bash Pass Error"
    [ "$BP_ERROR_SHOWN" -eq 1 ] && return
    printf "${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${RED}${BOLD}Error${RESET}\n"
    BP_ERROR_SHOWN=1
}
bp_notice() {  # "Bash Pass Notice"
    [ "$BP_NOTICE_SHOWN" -eq 1 ] && return
    printf "${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${YELLOW}${BOLD}Notice${RESET}\n"
    BP_NOTICE_SHOWN=1
}
bp_title() {   # bare "Bash Pass"
    [ "$BP_TITLE_SHOWN" -eq 1 ] && return
    printf "${GREEN}${ULINE}${BOLD}Bash Pass${RESET}\n"
    BP_TITLE_SHOWN=1
}
bp_accepted() { # "Bash Pass Accepted"
    [ "$BP_ACCEPTED_SHOWN" -eq 1 ] && return
    printf "${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${GREEN}${BOLD}Accepted${RESET}\n"
    BP_ACCEPTED_SHOWN=1
}
bp_wanted() {  # "\r\nBash Pass Wanted\r\n"
    [ "$BP_WANTED_SHOWN" -eq 1 ] && return
    printf "\r\n${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${YELLOW}${BOLD}Wanted${RESET}\r\n"
    BP_WANTED_SHOWN=1
}
bp_rescinded() { # "\r\nBash Pass Rescinded\r\n"
    [ "$BP_RESCINDED_SHOWN" -eq 1 ] && return
    printf "\r\n${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${RED}${BOLD}Rescinded${RESET} ${GREEN}${BOLD}Successfully${RESET}\r\n"
    BP_RESCINDED_SHOWN=1
}
bp_timer_end() { # "\r\nBash Pass Timer Expired / Session Terminated\r\n"
    [ "$BP_TIMER_END_SHOWN" -eq 1 ] && return
    if [ "$TERMINATED_BY_TIMER" -eq 1 ]; then
        printf "\r\n${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${YELLOW}${BOLD}Timer${RESET} ${RED}${BOLD}Expired${RESET}\r\n"
    else
        printf "\r\n${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${BRIGHT_BLUE}${BOLD}Session${RESET} ${RED}${BOLD}Terminated${RESET}\r\n"
    fi
    BP_TIMER_END_SHOWN=1
}
bp_assign() {  # "Automatically Assigning Pass" (banner subtitle)
    [ "$BP_ASSIGN_SHOWN" -eq 1 ] && return
    printf "${GREEN}Automatically${RESET} ${CYAN}Assigning${RESET} ${BRIGHT_GREEN}Pass${RESET}\n"
    BP_ASSIGN_SHOWN=1
}

# Ctrl+C is not assigned to anything outside session selection: the trap is
# a pure no-op so apps running inside the session can be interrupted
# normally, the interactive session shell handles SIGINT itself, and pass
# never dies from it. (Without any handler at all, bash would kill the
# script right after a Ctrl+C-interrupted child exits; an ignore trap
# instead would leak SIG_IGN into the session shell and its apps, making
# Ctrl+C unkillable — both wrong.) Registered here, before the selection
# menu, so it also protects the dialog stage. The selection prompt checks
# the interrupted read's status and is the only place that turns Ctrl+C
# into an exit.
trap ':' SIGINT

# Terminal-identity variables describe the CLIENT's terminal (the display
# surface the user is actually looking at), NOT the target session's. They
# must never be grafted from the leader's session later on, or TUI apps
# (htop, vim, tmux, ...) will render with the target session's terminal
# capabilities — e.g. TERM=linux from a console session, or no TERM at all
# from a GUI-app leader — instead of the caller's, killing colours.
TERM_IDENTITY_NAMES=(TERM TERMCAP COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION VTE_VERSION KONSOLE_PROFILE_NAME COLORFGBG NO_COLOR)
TERM_IDENTITY=()
for TV in "${TERM_IDENTITY_NAMES[@]}"; do
    [ -n "${!TV:-}" ] && TERM_IDENTITY+=("$TV=${!TV}")
done

# Argument Check Module
HAS_ARGS=0
SILENT=0
LIST=0
ASSIST=0
SORT=""
PASS_DEST=""
PASS_FIRST=0
ONLY=0
ONLY_CMD=""
FIRST_CMD=""
LAST_CMD=""
TIMER=""
WARNTIME=""
WARNEXEC=""
TIMEXEC_SECS=()
TIMEXEC_CMDS=()
WARNED=0
LOCATION=""
STRICT_LOC=1
LOC_FALLBACK=0
FAILED_LOC=""
AUDIT_MODE=""
AUDIT_PATH=""
AUDIT_FALLBACK=0
AUDIT_NAME_CONFLICT=0
DESIRED_AUDIT_FILE=""
DESIRED_AUDIT_DIR=""
CUSTOM_AUDIT_PATH=""
WANTED_STRS=()
WANTED_CMDS=()

# fmt_duration: format a second count in compact units — 600 → "10m",
# 605 → "10m5s", 3665 → "1h1m5s" (zero units are omitted, seconds included
# only when non-zero).
fmt_duration() {
    local secs=$1 out="" d h m s
    d=$((secs / 86400)); secs=$((secs % 86400))
    h=$((secs / 3600)); secs=$((secs % 3600))
    m=$((secs / 60)); s=$((secs % 60))
    [ "$d" -gt 0 ] && out+="${d}d"
    [ "$h" -gt 0 ] && out+="${h}h"
    [ "$m" -gt 0 ] && out+="${m}m"
    [ "$s" -gt 0 ] && out+="${s}s"
    [ -z "$out" ] && out="${s}s"
    printf '%s' "$out"
}

# warn_expired: the standard timer warning — header + the expired value, plus
# the remaining-time line when a remaining value is given. Interrupting the
# session shell re-issues its prompt (echoctl is off, so no ^C is shown).
warn_expired() {
    printf "\r\n${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${YELLOW}${BOLD}Timer Warning${RESET} ${RED}${BOLD}Expired${RESET}\r\n"
    printf "Your ${YELLOW}timer warning${RESET} for ${ULINE}${BRIGHT_BLUE}$(fmt_duration "$1")${RESET} has ${RED}expired${RESET}\r\n"
    if [ -n "$2" ]; then
        printf "Your ${YELLOW}timer${RESET} has ${ULINE}${BRIGHT_BLUE}$(fmt_duration "$2")${RESET} ${YELLOW}remaining${RESET}\r\n"
    fi
    B_PID=$(session_shell_pid)
    [ -n "$B_PID" ] && kill -INT "$B_PID" 2>/dev/null
}

# session_shell_pid: resolve the live session shell by process tree — the
# bash directly under the sudo wrapper whose command line contains
# "--rcfile <payload>". Exact fixed-string matching on sudo's space-joined
# cmdline (trailing space included so one payload path cannot prefix-match
# another); no regex metacharacter surprises from the payload path.
session_shell_pid() {
    local P SPID
    for P in $(pgrep -x sudo 2>/dev/null); do
        if tr '\0' ' ' < "/proc/$P/cmdline" 2>/dev/null | grep -Fq -- "--rcfile $PAYLOAD "; then
            SPID=$P
            break
        fi
    done
    [ -n "${SPID:-}" ] && pgrep -P "$SPID" -x bash 2>/dev/null | tail -n 1
}

# sq: escape single quotes so a value can be embedded safely inside the payload's
# single-quoted echo -e lines (e.g. an audit path containing a quote).
sq() {
    printf '%s' "${1//\'/\'\\\'\'}"
}

# parse_time: convert a time string (e.g. 3.5d, 5D2H, 30m, 10s) to seconds.
# Echoes "INVALID" when the format is not recognized or totals <= 0.
parse_time() {
    echo "$1" | awk '{
        str = tolower($0);
        total = 0;
        num = "";
        valid = 1;
        for (i = 1; i <= length(str); i++) {
            c = substr(str, i, 1);
            if ((c >= "0" && c <= "9") || c == ".") {
                if (c == "." && num ~ /\./) {
                    valid = 0;
                    break;
                }
                num = num c;
            } else if (c ~ /[smhdy]/) {
                if (num != "") {
                    val = num + 0;
                    if (c == "s") mult = 1;
                    else if (c == "m") mult = 60;
                    else if (c == "h") mult = 3600;
                    else if (c == "d") mult = 86400;
                    else if (c == "y") mult = 31536000;
                    total += val * mult;
                    num = "";
                } else {
                    valid = 0;
                    break;
                }
            } else {
                valid = 0;
                break;
            }
        }
        if (num != "") {
            total += (num + 0);
        }
        if (valid == 0 || total <= 0 || total > 3153600000) {
            print "INVALID"
        } else {
            printf "%d", total;
        }
    }'
}

if [ "$#" -gt 0 ]; then
    HAS_ARGS=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -silent)
                SILENT=1
                shift
                ;;
            -assist)
                ASSIST=1
                shift
                ;;
            -list)
                LIST=1
                # Capture the next parameter as SORT if it exists and is not another flag
                if [[ -n "$2" && "$2" != -* ]]; then
                    SORT="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            -pass)
                # Capture the next parameter as PASS_DEST if it exists and is not another flag;
                # when missing, auto-select the first indexed session (per the styled help)
                if [[ -n "$2" && "$2" != -* ]]; then
                    PASS_DEST="$2"
                    shift 2
                else
                    PASS_FIRST=1
                    shift
                fi
                ;;
            --pass)
                # Strict variant: a destination argument is required
                if [[ -n "$2" && "$2" != -* ]]; then
                    PASS_DEST="$2"
                    shift 2
                else
                    [ "$SILENT" -ne 1 ] && {
                        bp_error
                        printf -- "${ULINE}${YELLOW}--pass${RESET} ${CYAN}requires${RESET} a ${YELLOW}destination argument${RESET}\n"
                        printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                    }
                    exit 1
                fi
                ;;
            -location)
                if [[ -n "$2" && "$2" != -* ]]; then
                    LOCATION="$2"
                    STRICT_LOC=0
                    shift 2
                else
                    shift
                fi
                ;;
            --location)
                if [[ -n "$2" && "$2" != -* ]]; then
                    LOCATION="$2"
                    STRICT_LOC=1
                    shift 2
                else
                    [ "$SILENT" -ne 1 ] && {
                        bp_error
                        printf -- "${ULINE}${YELLOW}--location${RESET} ${CYAN}requires${RESET} a ${YELLOW}path argument${RESET}\n"
                        printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                    }
                    exit 1
                fi
                ;;
            -audit)
                AUDIT_MODE="clean"
                if [[ -n "$2" && "$2" != -* ]]; then
                    AUDIT_PATH="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            --audit)
                AUDIT_MODE="raw"
                if [[ -n "$2" && "$2" != -* ]]; then
                    AUDIT_PATH="$2"
                    shift 2
                else
                    shift
                fi
                ;;
            -wanted)
                # Repeatable: each use appends its watch strings, so multiple
                # -wanted arguments stay active. [STR] may be a comma-separated
                # list ("a","b"), letting one argument watch several values.
                # The optional [CMD] applies to every string of this use.
                if [[ -n "$2" && "$2" != -* ]]; then
                    WANTED_ARG_STR="$2"
                    WANTED_ARG_CMD=""
                    if [[ -n "$3" && "$3" != -* ]]; then
                        WANTED_ARG_CMD="$3"
                        shift 3
                        # Join any further non-flag words into the command
                        while [[ -n "$1" && "$1" != -* ]]; do
                            WANTED_ARG_CMD+=" $1"
                            shift
                        done
                    else
                        shift 2
                    fi
                    # Split [STR] on commas and trim whitespace around each part
                    WANTED_USE_ADDED=0
                    IFS=',' read -ra WANTED_PARTS <<< "$WANTED_ARG_STR"
                    for WANTED_PART in "${WANTED_PARTS[@]}"; do
                        WANTED_PART="${WANTED_PART#"${WANTED_PART%%[![:space:]]*}"}"
                        WANTED_PART="${WANTED_PART%"${WANTED_PART##*[![:space:]]}"}"
                        if [ -n "$WANTED_PART" ]; then
                            WANTED_STRS+=("$WANTED_PART")
                            WANTED_CMDS+=("$WANTED_ARG_CMD")
                            WANTED_USE_ADDED=1
                        fi
                    done
                    if [ "$WANTED_USE_ADDED" -eq 0 ]; then
                        bp_error
                        printf -- "${ULINE}${YELLOW}-wanted${RESET} ${CYAN}requires${RESET} a ${YELLOW}search string${RESET}\n"
                        printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                        exit 1
                    fi
                else
                    bp_error
                    printf -- "${ULINE}${YELLOW}-wanted${RESET} ${CYAN}requires${RESET} a ${YELLOW}search string${RESET}\n"
                    printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                    exit 1
                fi
                ;;
            -only)
                if [[ -n "$2" && "$2" != -* ]]; then
                    ONLY_CMD="$2"
                    shift 2
                    # Join any further non-flag words into the command
                    while [[ -n "$1" && "$1" != -* ]]; do
                        ONLY_CMD+=" $1"
                        shift
                    done
                else
                    # No [CMD] given: per the wiki, connect, execute nothing,
                    # and immediately disconnect from the session.
                    ONLY=1
                    shift
                fi
                ;;
            -first)
                if [[ -n "$2" && "$2" != -* ]]; then
                    FIRST_CMD="$2"
                    shift 2
                    # Join any further non-flag words into the command
                    while [[ -n "$1" && "$1" != -* ]]; do
                        FIRST_CMD+=" $1"
                        shift
                    done
                else
                    shift
                fi
                ;;
            -last)
                if [[ -n "$2" && "$2" != -* ]]; then
                    LAST_CMD="$2"
                    shift 2
                    # Join any further non-flag words into the command
                    while [[ -n "$1" && "$1" != -* ]]; do
                        LAST_CMD+=" $1"
                        shift
                    done
                else
                    shift
                fi
                ;;
            --timer)
                # Repeatable: each --timer [TIME] [TIMEXEC] adds one timer that
                # warns and executes [TIMEXEC] on expiry without disconnecting
                TIMEXEC_TIME_RAW=""
                TIMEXEC_CMD=""
                if [[ -n "$2" && "$2" != -* ]]; then
                    TIMEXEC_TIME_RAW="$2"
                    shift 2
                    # Optional [TIMEXEC]: join any further non-flag words
                    while [[ -n "$1" && "$1" != -* ]]; do
                        TIMEXEC_CMD+="${TIMEXEC_CMD:+ }$1"
                        shift
                    done
                fi
                if [ -n "$TIMEXEC_TIME_RAW" ]; then
                    TT_SECS=$(parse_time "$TIMEXEC_TIME_RAW")
                    if [ "$TT_SECS" == "INVALID" ]; then
                        bp_error
                        printf "${ULINE}${YELLOW}$TIMEXEC_TIME_RAW${RESET} is an ${RED}invalid${RESET} ${YELLOW}time format${RESET}\n"
                        printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                        exit 1
                    fi
                    TIMEXEC_SECS+=("$TT_SECS")
                    TIMEXEC_CMDS+=("$TIMEXEC_CMD")
                else
                    bp_error
                    printf -- "${ULINE}${YELLOW}--timer${RESET} ${CYAN}requires${RESET} a ${YELLOW}defined time value${RESET}\n"
                    printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                    exit 1
                fi
                ;;
            -timer*)
                TIMER_RAW=""
                WARNTIME_RAW=""
                if [[ "$1" == "-timer" ]]; then
                    if [[ -n "$2" && "$2" != -* ]]; then
                        TIMER_RAW="$2"
                        shift 2
                        # Optional [WARNTIME]: a second argument, when present
                        if [[ -n "$1" && "$1" != -* ]]; then
                            WARNTIME_RAW="$1"
                            shift 1
                            # Optional [WARNEXEC]: a third argument, when present —
                            # join any further non-flag words into the command
                            while [[ -n "$1" && "$1" != -* ]]; do
                                WARNEXEC+="${WARNEXEC:+ }$1"
                                shift
                            done
                        fi
                    else
                        shift
                    fi
                else
                    TIMER_RAW="${1#-timer}"
                    shift
                fi
                
                if [ -n "$TIMER_RAW" ]; then
                    TIMER=$(parse_time "$TIMER_RAW")
                    
                    if [ "$TIMER" == "INVALID" ]; then
                        bp_error
                        printf "${ULINE}${YELLOW}$TIMER_RAW${RESET} is an ${RED}invalid${RESET} ${YELLOW}time format${RESET}\n"
                        printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                        exit 1
                    fi
                    
                    if [ -n "$WARNTIME_RAW" ]; then
                        WARNTIME=$(parse_time "$WARNTIME_RAW")
                        
                        if [ "$WARNTIME" == "INVALID" ]; then
                            bp_error
                            printf "${ULINE}${YELLOW}$WARNTIME_RAW${RESET} is an ${RED}invalid${RESET} ${YELLOW}time format${RESET}\n"
                            printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                            exit 1
                        fi
                        
                        if [ "$WARNTIME" -ge "$TIMER" ]; then
                            bp_error
                            printf -- "${CYAN}Warning-time${RESET} of ${BRIGHT_BLUE}$WARNTIME_RAW${RESET} ${RED}is ${ULINE}not${RESET} ${RED}within${RESET} ${YELLOW}range of timer:${RESET} ${BRIGHT_BLUE}$TIMER_RAW${RESET}\n"
                            printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                            exit 1
                        fi
                    fi
                else
                    bp_error
                    printf -- "${ULINE}${YELLOW}-timer${RESET} ${CYAN}requires${RESET} a ${YELLOW}defined time value${RESET}\n"
                    printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                    exit 1
                fi
                ;;
            -help|-h|--help)
                # Styled help lives in bash-pass-help (same directory); it
                # defines its own style variables and also runs standalone.
                HELP_FILE="$(dirname "$0")/bash-pass-help"
                if [ ! -f "$HELP_FILE" ]; then
                    [ "$SILENT" -ne 1 ] && {
                        bp_error
                        printf -- "${ULINE}${YELLOW}bash-pass-help${RESET} ${RED}is ${ULINE}missing${RESET} from ${CYAN}${ULINE}$(dirname "$0")${RESET}\n"
                        printf "${CYAN}Reinstall${RESET} ${GREEN}Bash Pass${RESET} or ${CYAN}place${RESET} the ${YELLOW}help file${RESET} next to the ${GREEN}app${RESET}\n"
                    }
                    exit 1
                fi
                source "$HELP_FILE"
                exit 0
                ;;
            -version|--version)
                printf "${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${GREEN}installed${RESET} ${CYAN}version${RESET}: ${BRIGHT_BLUE}${VERSION}${RESET}\n"
                exit 0
                ;;
            *)
                bp_error
                printf -- "${ULINE}${YELLOW}$1${RESET} is ${BRIGHT_RED}not${RESET} a ${GREEN}valid${RESET} ${YELLOW}argument${RESET}\n"
                printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
                exit 1
                ;;
        esac
    done
fi

if [ -n "$ONLY_CMD" ] || [ "$ONLY" -eq 1 ]; then
    if [ -n "$FIRST_CMD" ] || [ -n "$LAST_CMD" ]; then
        [ "$SILENT" -ne 1 ] && {
            bp_error
            printf -- "${ULINE}${YELLOW}-only${RESET} ${BRIGHT_RED}cannot${RESET} be used ${CYAN}simultaneously${RESET} with ${ULINE}${YELLOW}-first${RESET} or ${ULINE}${YELLOW}-last${RESET}\n"
            printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
        }
        exit 1
    fi
fi

if [ "$ASSIST" -eq 1 ]; then
    if ! command -v dialog >/dev/null 2>&1; then
        [ "$SILENT" -ne 1 ] && {
            bp_error
            printf -- "${ULINE}${YELLOW}-assist${RESET} ${RED}requires${RESET} the ${ULINE}${CYAN}dialog utility${RESET} to ${GREEN}run${RESET}\n"
            printf "${CYAN}Install${RESET} the ${ULINE}${YELLOW}dialog package${RESET} to ${CYAN}use${RESET} this ${YELLOW}argument${RESET}\n"
            printf "${CYAN}Use${RESET} ${ULINE}${YELLOW}-help${RESET} for ${CYAN}information${RESET} about ${GREEN}proper use${RESET}\n"
        }
        exit 1
    fi
fi

if [ "$EUID" -ne 0 ]; then
    [ "$SILENT" -ne 1 ] && {
        bp_error
        printf "${ULINE}${YELLOW}root privilege${RESET} is ${RED}required${RESET} (${CYAN}${ULINE}run with sudo${RESET})\n"
    }
    exit 1
fi

# Process Scanner
CPID=$$
ANCESTORS=" "
while [ -n "$CPID" ] && [ "$CPID" -gt 1 ]; do
    CPID=$(awk '{print $4}' "/proc/$CPID/stat" 2>/dev/null)
    [ -n "$CPID" ] && ANCESTORS+="$CPID "
done

declare -a USERS TYPES TTYS LDRS PRINT_TYPES
IDX=1

# Session Details
for SID in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
    TYPE=$(loginctl show-session "$SID" -p Type | awk -F= '{print $2}')
    [ "$TYPE" == "unspecified" ] && continue
    
    LEADER=$(loginctl show-session "$SID" -p Leader | awk -F= '{print $2}')
    [ -n "$LEADER" ] && [[ "$ANCESTORS" == *" $LEADER "* ]] && continue
    
    USER=$(loginctl show-session "$SID" -p Name | awk -F= '{print $2}')
    S_TTY=$(loginctl show-session "$SID" -p TTY | awk -F= '{print $2}')
    [ -z "$USER" ] && continue
    
    # Assimilate the TTY-to-IP mapping
    PRINT_TYPE="$TYPE"
    # Tag graphical sessions as "<type> display" so -pass/-list can target them with "display"
    if [ "$TYPE" == "wayland" ] || [ "$TYPE" == "x11" ]; then
        PRINT_TYPE="$TYPE display"
    fi
    if [ -n "$S_TTY" ]; then
        WHO_IP=$(who | awk -v t="$S_TTY" '$2 == t {print $5}' 2>/dev/null)
        [ -n "$WHO_IP" ] && PRINT_TYPE="$PRINT_TYPE $WHO_IP"
    fi
    
    USERS[$IDX]=$USER
    TYPES[$IDX]=$TYPE 
    TTYS[$IDX]=$S_TTY
    LDRS[$IDX]=$LEADER
    PRINT_TYPES[$IDX]=$PRINT_TYPE
    
    ((IDX++))
done

# Environment Check
TARGET_COUNT=${#USERS[@]}

if [ "$TARGET_COUNT" -eq 0 ]; then
    [ "$SILENT" -ne 1 ] && {
        bp_error
        printf "${RED}failed${RESET} to ${CYAN}find${RESET} a ${GREEN}session${RESET}\n"
    }
    exit 1
elif [ "$TARGET_COUNT" -eq 1 ] && [ "$LIST" -eq 0 ] && [ -z "$SORT" ] && [ -z "$PASS_DEST" ]; then
    SEL=$(echo "${!USERS[@]}")
    [ "$SILENT" -ne 1 ] && {
        clear
        bp_title
        printf "${BRIGHT_BLUE}Singular${RESET} ${ULINE}${GREEN}session${RESET} ${CYAN}identified${RESET}\n"
        sleep 0.5
        bp_assign
        sleep 0.5
    }
else
    if [ -n "$PASS_DEST" ] || [ "$PASS_FIRST" -eq 1 ]; then
        if [ "$PASS_FIRST" -eq 1 ]; then
            SEL=1
        elif [ "$PASS_DEST" == "oldest" ]; then
            SEL=1
        elif [ "$PASS_DEST" == "latest" ]; then
            SEL=$TARGET_COUNT
        else
            # Exact matches first (so a numeric uid like "0" matches the exact uid,
            # not the first substring hit such as "1000"), then substring matches.
            for i in "${!USERS[@]}"; do
                T_UID=$(id -u "${USERS[$i]}" 2>/dev/null)
                T_TTY="${TTYS[$i]:-Headless}"
                T_TYPE="${PRINT_TYPES[$i]}"
                T_USER="${USERS[$i]}"
                if [[ "$T_USER" == "$PASS_DEST" ]] || [[ "$T_UID" == "$PASS_DEST" ]] || [[ "$T_TTY" == "$PASS_DEST" ]] || [[ "$T_TYPE" == "$PASS_DEST" ]]; then
                    SEL=$i
                    break
                fi
            done
            if [ -z "$SEL" ]; then
                for i in "${!USERS[@]}"; do
                    T_UID=$(id -u "${USERS[$i]}" 2>/dev/null)
                    T_TTY="${TTYS[$i]:-Headless}"
                    T_TYPE="${PRINT_TYPES[$i]}"
                    T_USER="${USERS[$i]}"
                    if [[ "$T_USER" == *"$PASS_DEST"* ]] || [[ "$T_UID" == *"$PASS_DEST"* ]] || [[ "$T_TTY" == *"$PASS_DEST"* ]] || [[ "$T_TYPE" == *"$PASS_DEST"* ]]; then
                        SEL=$i
                        break
                    fi
                done
            fi
        fi
        
        # Failsafe if the pass argument yielded zero matches
        if [ -z "$SEL" ]; then
            [ "$SILENT" -ne 1 ] && {
                bp_error
                printf "${RED}No results${RESET} ${CYAN}found${RESET} for ${ULINE}${YELLOW}$PASS_DEST${RESET}\n"
            }
            exit 1
        fi

        # -list must display without entering: with a resolved destination,
        # show the single matched row in the same table format and stop.
        if [ "$LIST" -eq 1 ]; then
            T_UID=$(id -u "${USERS[$SEL]}" 2>/dev/null)
            T_TTY="${TTYS[$SEL]:-Headless}"
            T_TYPE="${PRINT_TYPES[$SEL]}"
            T_USER="${USERS[$SEL]}"
            printf "${BOLD}│${RESET} ${BLUE}${BOLD}NUM${RESET} | ${GREEN}${BOLD}USER${RESET} | ${YELLOW}${BOLD}UID${RESET} | ${CYAN}${BOLD}TTY${RESET} | ${YELLOW}${BOLD}TYPE${RESET} ${BOLD}│${RESET}\n"
            printf "${BOLD}├───────────────────────────────┘${RESET}\n"
            printf "${BOLD}│${RESET} ${BLUE}${BOLD}%d)${RESET} ${GREEN}%s${RESET} | ${YELLOW}%s${RESET} | ${CYAN}%s${RESET} | ${YELLOW}%s${RESET}\n" "$SEL" "$T_USER" "$T_UID" "$T_TTY" "$T_TYPE"
            printf "${BOLD}└────────────────────────────────${RESET}\n"
            exit 0
        fi

        [ "$SILENT" -ne 1 ] && {
            clear
            bp_title
            printf "${YELLOW}Targeted${RESET} ${ULINE}${GREEN}session${RESET} ${CYAN}identified${RESET}\n"
            sleep 0.5
            bp_assign
            sleep 0.5
        }
    else
        # Pre-calculate sort matches to determine if the table should be drawn
        if [ -n "$SORT" ]; then
            MATCH_COUNT=0
            for i in "${!USERS[@]}"; do
                T_UID=$(id -u "${USERS[$i]}" 2>/dev/null)
                T_TTY="${TTYS[$i]:-Headless}"
                T_TYPE="${PRINT_TYPES[$i]}"
                T_USER="${USERS[$i]}"
                
                if [[ "$T_USER" == *"$SORT"* ]] || [[ "$T_UID" == *"$SORT"* ]] || [[ "$T_TTY" == *"$SORT"* ]] || [[ "$T_TYPE" == *"$SORT"* ]]; then
                    ((MATCH_COUNT++))
                fi
            done
            
            if [ "$MATCH_COUNT" -eq 0 ]; then
                [ "$SILENT" -ne 1 ] && {
                    bp_error
                    printf "${RED}No results${RESET} ${CYAN}found${RESET} for ${ULINE}${YELLOW}${SORT}${RESET}\n"
                }
                exit 1
            fi
        fi

        clear
        if [ "$ASSIST" -eq 1 ] && [ "$LIST" -eq 0 ]; then
            # -assist: render the selection as a dialog menu instead of the table
            ITEMS=()
            if [ -z "$SORT" ]; then
                for i in "${!USERS[@]}"; do
                    T_UID=$(id -u "${USERS[$i]}" 2>/dev/null)
                    ITEMS+=("$i" "${USERS[$i]} | $T_UID | ${TTYS[$i]:-Headless} | ${PRINT_TYPES[$i]}")
                done
            else
                for i in "${!USERS[@]}"; do
                    T_UID=$(id -u "${USERS[$i]}" 2>/dev/null)
                    T_TTY="${TTYS[$i]:-Headless}"
                    T_TYPE="${PRINT_TYPES[$i]}"
                    T_USER="${USERS[$i]}"
                    
                    # Include row only if SORT string is found in at least one column
                    if [[ "$T_USER" == *"$SORT"* ]] || [[ "$T_UID" == *"$SORT"* ]] || [[ "$T_TTY" == *"$SORT"* ]] || [[ "$T_TYPE" == *"$SORT"* ]]; then
                        ITEMS+=("$i" "$T_USER | $T_UID | $T_TTY | $T_TYPE")
                    fi
                done
            fi
            exec 3>&1
            SEL=$(dialog --clear  --backtitle "Bash Pass" --title "Identified Sessions" --menu "Select the desired session to create a pass:" 0 0 0 "${ITEMS[@]}" 2>&1 1>&3)
            DRC=$?
            exec 3>&-
            if [ "$DRC" -ne 0 ]; then
                # Cancel/ESC/Ctrl+C: the selection stage is the one place
                # Ctrl+C may exit the app. dialog leaves its screen behind —
                # reset the terminal attributes and repaint before exiting.
                tput sgr0 2>/dev/null
                tput cnorm 2>/dev/null
                clear
                exit 1
            fi
        else
        printf "${BOLD}│${RESET} ${BLUE}${BOLD}NUM${RESET} | ${GREEN}${BOLD}USER${RESET} | ${YELLOW}${BOLD}UID${RESET} | ${CYAN}${BOLD}TTY${RESET} | ${YELLOW}${BOLD}TYPE${RESET} ${BOLD}│${RESET}\n"
        printf "${BOLD}├───────────────────────────────┘${RESET}\n"
        
        if [ -z "$SORT" ]; then
            for i in "${!USERS[@]}"; do
                T_UID=$(id -u "${USERS[$i]}" 2>/dev/null)
                printf "${BOLD}│${RESET} ${BLUE}${BOLD}%d)${RESET} ${GREEN}%s${RESET} | ${YELLOW}%s${RESET} | ${CYAN}%s${RESET} | ${YELLOW}%s${RESET}\n" "$i" "${USERS[$i]}" "$T_UID" "${TTYS[$i]:-Headless}" "${PRINT_TYPES[$i]}"
            done
        else
            for i in "${!USERS[@]}"; do
                T_UID=$(id -u "${USERS[$i]}" 2>/dev/null)
                T_TTY="${TTYS[$i]:-Headless}"
                T_TYPE="${PRINT_TYPES[$i]}"
                T_USER="${USERS[$i]}"
                
                # Print row only if SORT string is found in at least one column
                if [[ "$T_USER" == *"$SORT"* ]] || [[ "$T_UID" == *"$SORT"* ]] || [[ "$T_TTY" == *"$SORT"* ]] || [[ "$T_TYPE" == *"$SORT"* ]]; then
                    printf "${BOLD}│${RESET} ${BLUE}${BOLD}%d)${RESET} ${GREEN}%s${RESET} | ${YELLOW}%s${RESET} | ${CYAN}%s${RESET} | ${YELLOW}%s${RESET}\n" "$i" "$T_USER" "$T_UID" "$T_TTY" "$T_TYPE"
                fi
            done
        fi
        
        printf "${BOLD}└────────────────────────────────${RESET}\n"
        
        if [ "$LIST" -eq 1 ]; then
            exit 0
        fi
        
        [ "$SILENT" -ne 1 ] && printf "${CYAN}Select${RESET} the ${ULINE}${GREEN}desired session${RESET} by ${BRIGHT_BLUE}number${RESET} to ${YELLOW}create${RESET} a ${BRIGHT_GREEN}pass${RESET}\n"
        # The selection prompt is the one place Ctrl+C may exit the app:
        # while reading, the SIGINT no-op trap is temporarily cleared so the
        # signal interrupts read immediately (a set trap would be deferred
        # until read returned). Invalid input re-prompts; "exit" and EOF
        # (window close) also end the run.
        while true; do
            trap - SIGINT
            read -r -p "> " SEL
            rc=$?
            trap ':' SIGINT
            if [ "$rc" -gt 128 ]; then
                # Interrupted by Ctrl+C: leave the app, silently (keep the
                # caller's prompt on its own line)
                printf '\n'
                exit 130
            fi
            if [ "$rc" -ne 0 ]; then
                # EOF: the input stream (window) closed
                exit 1
            fi
            [ "$SEL" = "exit" ] && exit 0
            if [[ ! "$SEL" =~ ^[0-9]+$ ]] || [ -z "${USERS[$SEL]}" ]; then
                [ "$SILENT" -ne 1 ] && {
                    bp_error
                    printf "${YELLOW}${SEL}${RESET} ${RED}is not within${RESET} ${CYAN}available range${RESET}: ${BRIGHT_BLUE}1-${#USERS[@]}${RESET}\n"
                }
                continue
            fi
            break
        done
        fi
        
        # Dialog safety net: dialog returns an index tag directly, but never
        # trust it blindly.
        if [[ ! "$SEL" =~ ^[0-9]+$ ]] || [ -z "${USERS[$SEL]}" ]; then
            exit 1
        fi
    fi
fi

# Process Location
