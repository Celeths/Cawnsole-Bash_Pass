    if [[ "$LOCATION" == "~" ]]; then
        TARGET_HOME=$(getent passwd "${USERS[$SEL]}" 2>/dev/null | cut -d: -f6)
        [ -n "$TARGET_HOME" ] && LOCATION="$TARGET_HOME"
