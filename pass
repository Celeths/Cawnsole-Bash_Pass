if [ -n "$TIMER" ] && [ "$SILENT" -ne 1 ]; then
    echo "if [ \"\$BP_NOTICE_SHOWN\" != \"1\" ]; then echo -e '${GREEN}${ULINE}${BOLD}Bash Pass${RESET} ${YELLOW}${BOLD}Notice${RESET}'; export BP_NOTICE_SHOWN=1; fi" >> "$PAYLOAD"
    if [ -n "$WARNTIME" ]; then
        echo "echo -e 'This is a ${CYAN}timed${RESET} ${BRIGHT_BLUE}session${RESET}. ${YELLOW}Timer length:${RESET} ${ULINE}${BRIGHT_BLUE}$(fmt_duration "$TIMER")${RESET}. ${YELLOW}Warning at:${RESET} ${ULINE}${BRIGHT_BLUE}$(fmt_duration "$WARNTIME")${RESET}'" >> "$PAYLOAD"
    else
        echo "echo -e 'This is a ${CYAN}timed${RESET} ${BRIGHT_BLUE}session${RESET}. ${YELLOW}Timer length:${RESET} ${ULINE}${BRIGHT_BLUE}$(fmt_duration "$TIMER")${RESET}'" >> "$PAYLOAD"
    fi
fi

if [ -n "$LOCATION" ]; then
    echo "cd $(printf "%q" "$LOCATION") 2>/dev/null" >> "$PAYLOAD"
else
    # Default location is the target session owner's home (per help/WIKI).
    echo "cd ~ 2>/dev/null" >> "$PAYLOAD"
fi

if [ -n "$FIRST_CMD" ]; then
    # Detached: runs in the background of the session shell and outlives it
    echo "( $FIRST_CMD </dev/null & )" >> "$PAYLOAD"
fi

if [ -n "$ONLY_CMD" ] || [ "$ONLY" -eq 1 ]; then
    [ -n "$ONLY_CMD" ] && echo "( $ONLY_CMD </dev/null & )" >> "$PAYLOAD"
    echo "builtin exit 0" >> "$PAYLOAD"
fi

chown "$T_USER" "$PAYLOAD"
chmod 600 "$PAYLOAD"

# Flavour Text
# The Synthesized UI Matrix
[ "$SILENT" -ne 1 ] && {
    clear
    printf "Your ${BRIGHT_GREEN}Pass${RESET} ${CYAN}has been${RESET} ${GREEN}crafted${RESET}:\n\n"
    printf "${BOLD}╭───────────────────────╮${RESET}\n"
    printf "${BOLD}│${RESET} ${GREEN}${BOLD}Bash Pass${RESET} ${BOLD}${CYAN}%12s${RESET}${BOLD}│${RESET}\n" "$D_TTY"
    printf "${BOLD}│${RESET}${YELLOW}${BOLD}%23s${RESET}${BOLD}│${RESET}\n" "$D_UID"
    printf "${BOLD}│${RESET}%23s${BOLD}│${RESET}\n" ""
    printf "${BOLD}│${RESET}${BOLD}User: ${ULINE}${GREEN}%-17s${RESET}${BOLD}│${RESET}\n" "$D_USER"
    printf "${BOLD}│${RESET}${BOLD}Env:  ${ULINE}${YELLOW}%-17s${RESET}${BOLD}│${RESET}\n" "$D_TYPE"
    printf "${BOLD}╰───────────────────────╯${RESET}\n"
    
    if [ "$AUDIT_FALLBACK" -eq 1 ] && [ "$AUDIT_NAME_CONFLICT" -ne 1 ]; then
        bp_notice
        printf "${GREEN}Location${RESET} ${ULINE}${YELLOW}${CUSTOM_AUDIT_PATH}${RESET} ${RED}is ${ULINE}not${RESET} ${RED}accessible${RESET}, ${CYAN}defaulting${RESET} ${CYAN}filepath${RESET} to ${GREEN}'$AUDIT_DIR'${RESET}\n"
    fi

    sleep 0.5
    printf "\n${CYAN}Presenting${RESET} ${BRIGHT_GREEN}pass${RESET} to ${GREEN}system..${RESET}${YELLOW}${BLINK}.${RESET}\n"
    sleep 3

    bp_accepted
    sleep 0.5
    clear
}

# Monitor the leader process and timer threshold
(
    # The parent's traps would cascade a second teardown back into the
    # session if this watchdog were signalled, and the inherited EXIT trap
    # would delete $PAYLOAD from inside the subshell; reset them all so the
    # cleanup kill ends this subshell outright.
    trap - EXIT SIGTERM SIGHUP SIGQUIT
    ELAPSED=0
    TERMINATED_BY_TIMER=0
    TIMEXEC_FIRED=()
    while kill -0 "$LEADER" 2>/dev/null; do
        if [ -n "$WARNTIME" ] && [ "$WARNED" -eq 0 ] && [ "$ELAPSED" -ge "$WARNTIME" ]; then
            [ "$SILENT" -ne 1 ] && warn_expired "$WARNTIME" "$((TIMER-WARNTIME))"
            # [WARNEXEC] runs when the warning fires — also under -silent
            [ -n "$WARNEXEC" ] && eval "$WARNEXEC"
            WARNED=1
        fi
        # Repeatable --timer entries: warn + exec once each, never disconnect
        for ((i=0; i<${#TIMEXEC_SECS[@]}; i++)); do
            if [ "${TIMEXEC_FIRED[$i]:-0}" -eq 0 ] && [ "$ELAPSED" -ge "${TIMEXEC_SECS[$i]}" ]; then
                TIMEXEC_FIRED[$i]=1
                TT_REM=""
                [ -n "$TIMER" ] && TT_REM=$((TIMER-${TIMEXEC_SECS[$i]}))
                [ "$SILENT" -ne 1 ] && warn_expired "${TIMEXEC_SECS[$i]}" "$TT_REM"
                [ -n "${TIMEXEC_CMDS[$i]}" ] && eval "${TIMEXEC_CMDS[$i]}"
            fi
        done
        if [ -n "$TIMER" ]; then
            if [ "$ELAPSED" -ge "$TIMER" ]; then
                TERMINATED_BY_TIMER=1
                break
            fi
        fi
        sleep 1
        ((ELAPSED+=1))
    done
    
    [ "$SILENT" -ne 1 ] && {
        bp_timer_end
        if [ "$TERMINATED_BY_TIMER" -eq 1 ]; then
            printf "Your ${YELLOW}timer${RESET} for ${ULINE}${BRIGHT_BLUE}$(fmt_duration "$TIMER")${RESET} has ${RED}expired${RESET}\r\n"
        fi
        printf "${YELLOW}Rescinding${RESET} your ${BRIGHT_GREEN}pass${RESET}\r\n"
    }
    
    kill_payload
    # No orphans: kill any exec still running in this subshell before exiting.
    # $BASHPID names this watchdog subshell itself — $$ would name the parent
    # pass process and sweep unrelated siblings (and miss these exec'd
    # children).
    pkill -P "$BASHPID" 2>/dev/null
) &
WATCHDOG_PID=$!

# Execute the shell with the payload with rcfile
if [ -n "$AUDIT_MODE" ] || [ "${#WANTED_STRS[@]}" -gt 0 ]; then
    RAW_AUDIT=$(mktemp)
    
    if [ "${#WANTED_STRS[@]}" -gt 0 ]; then
        (
            # Continuously monitor the session stream for ANY watch string. Use
            # unbuffered sed to strip ANSI escapes and resolve terminal
            # backspaces; grep -o then records the exact string that matched
            # first (fixed-string matches, one -e per watch string).
            WANTED_GREP_ARGS=()
            for WANTED_ONE in "${WANTED_STRS[@]}"; do
                WANTED_GREP_ARGS+=(-e "$WANTED_ONE")
            done
            WANTED_MATCH_FILE=$(mktemp)
            # Remove the match file however this monitor ends: EXIT covers
            # the normal completion path, TERM/HUP cover the teardown kills
            # (bash does not run EXIT traps on untrapped-signal death).
            trap 'rm -f "$WANTED_MATCH_FILE"' EXIT
            trap 'rm -f "$WANTED_MATCH_FILE"; exit 0' SIGTERM SIGHUP
            tail -n +1 -f "$RAW_AUDIT" 2>/dev/null | \
            sed -u -E -e 's/\x1B\][^\x07\x1B]*(\x07|\x1B\\)//g' \
                      -e 's/\x1B\[[0-9;?]*[A-Za-z]//g' \
                      -e 's/\x1B[()][A-Za-z]//g' \
                      -e ':a' -e 's/[^\x08\x7F][\x08\x7F]//g' -e 't a' \
                      -e 's/[\x08\x7F]//g' \
                      -e 's/\r//g' | \
            grep -m 1 -o -F "${WANTED_GREP_ARGS[@]}" > "$WANTED_MATCH_FILE" &
            WANTED_GREP_PID=$!
            # Poll for the recorded match. A quiet stream leaves tail/sed
            # alive after grep exits, and `wait` would block on them, so the
            # monitor watches grep's liveness instead of waiting on the pipe.
            WANTED_MATCH=""
            while [ -z "$WANTED_MATCH" ] && kill -0 "$WANTED_GREP_PID" 2>/dev/null; do
                sleep 0.1
                WANTED_MATCH=$(head -n 1 "$WANTED_MATCH_FILE" 2>/dev/null)
            done
            # Reap the stream watchers before acting (grep is done by now).
            # $BASHPID — not $$, which still names the parent pass process —
            # so only this monitor's own tail/sed/grep children are killed.
            pkill -P "$BASHPID" 2>/dev/null
            rm -f "$WANTED_MATCH_FILE"
    
            if [ -n "$WANTED_MATCH" ]; then
                # Delay slightly to allow the PTY to visually render the final keystroke
                sleep 0.3
    
                # Find the [CMD] belonging to the matched string
                WANTED_MATCH_CMD=""
                for ((i=0; i<${#WANTED_STRS[@]}; i++)); do
                    if [ "${WANTED_STRS[$i]}" == "$WANTED_MATCH" ]; then
                        WANTED_MATCH_CMD="${WANTED_CMDS[$i]}"
                        break
                    fi
                done
    
                if [ -n "$WANTED_MATCH_CMD" ]; then
                    [ "$SILENT" -ne 1 ] && {
                        bp_wanted
                        printf "${CYAN}Target${RESET} ${ULINE}${YELLOW}%s${RESET} has ${GREEN}appeared${RESET}\r\n" "$WANTED_MATCH"
                        printf "${CYAN}Executing:${RESET} ${ULINE}${YELLOW}%s${RESET}\r\n" "$WANTED_MATCH_CMD"
                    }
                    eval "$WANTED_MATCH_CMD"
                    # Return the caret to the session prompt (same as the timer warning)
                    [ "$SILENT" -ne 1 ] && {
                        B_PID=$(session_shell_pid)
                        [ -n "$B_PID" ] && kill -INT "$B_PID" 2>/dev/null
                    }
                else
                    [ "$SILENT" -ne 1 ] && {
                        bp_wanted
                        printf "${CYAN}Target${RESET} ${ULINE}${YELLOW}%s${RESET} has ${GREEN}appeared${RESET}\r\n" "$WANTED_MATCH"
                        printf "${YELLOW}Rescinding${RESET} your ${BRIGHT_GREEN}pass${RESET}\r\n"
                    }
                    kill_payload
                fi
            fi
        ) &
        WANTED_PID=$!
    fi
    
    # Run the interactive bash wrapper internally via script, utilizing -f to flush stream outputs
    script -q -f -e -c "$RUN_CMD" "$RAW_AUDIT"
    
    if [ "${#WANTED_STRS[@]}" -gt 0 ]; then
        # Give the monitor time to finish printing if the marker appeared right
        # at the end of the session (it sleeps 0.3s after a match before acting)
        sleep 1
        # Children first, then the monitor itself (see cleanup_watchdogs)
        pkill -P "$WANTED_PID" 2>/dev/null
        kill "$WANTED_PID" 2>/dev/null
    fi
    
    if [ -n "$AUDIT_MODE" ]; then
        # Write via a fresh file in the same directory and rename into place, so a
        # symlink planted at the audit path is replaced, never followed (TOCTOU fix)
        AUDIT_TMP=$(mktemp "$(dirname "$AUDIT_PATH")/.audit.XXXXXX" 2>/dev/null)
        if [ -n "$AUDIT_TMP" ]; then
            if [ "$AUDIT_MODE" == "clean" ]; then
                # Strip OSC shell integration sequences and ANSI colors, retaining general output and exit codes
                sed -E -e 's/\x1B\][^\x07\x1B]*(\x07|\x1B\\)//g' \
                       -e 's/\x1B\[[0-9;?]*[A-Za-z]//g' \
                       -e 's/\x1B[()][A-Za-z]//g' "$RAW_AUDIT" | \
                col -b > "$AUDIT_TMP"
            elif [ "$AUDIT_MODE" == "raw" ]; then
                cat "$RAW_AUDIT" > "$AUDIT_TMP"
            fi
            mv -f "$AUDIT_TMP" "$AUDIT_PATH" 2>/dev/null
        fi
    fi
    
    if [ -n "$AUDIT_MODE" ]; then
        # Set appropriate ownership mapped to sudo issuer after writing is complete
        chown "$SUDO_RUNNER" "$AUDIT_PATH" 2>/dev/null
        chmod 644 "$AUDIT_PATH" 2>/dev/null
    fi
    
    rm -f "$RAW_AUDIT"
else
    sudo -u "$T_USER" /bin/bash --rcfile "$PAYLOAD" -i
fi

[ "$SILENT" -ne 1 ] && {
    bp_rescinded
    printf "${GREEN}Successfully${RESET} ${RED}rescinded${RESET} your ${GREEN}pass${RESET}\r\n"
    if [ -n "$AUDIT_MODE" ]; then
        printf "${CYAN}Audit receipt${RESET} ${GREEN}saved${RESET} to: ${ULINE}${GREEN}%s${RESET}\r\n" "$AUDIT_PATH"
    fi
}

exit 0
