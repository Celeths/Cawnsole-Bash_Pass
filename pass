    echo "echo -e '${GREEN}Location${RESET} ${ULINE}${YELLOW}$(sq "$FAILED_LOC")${RESET} ${RED}${ULINE}not${RESET} ${RED}found${RESET}, ${CYAN}defaulted${RESET} to ${GREEN}'\"\$PWD\"'${RESET}'" >> "$PAYLOAD"
