    DEFAULT_AUDIT_PATH="${DEFAULT_DIR}/${DEFAULT_FILE_NAME}"

    if [ -z "$AUDIT_PATH" ]; then
        AUDIT_PATH="$DEFAULT_AUDIT_PATH"
    else
        # Check if argument is strictly a file name without directory elements
        if [[ ! "$AUDIT_PATH" == */* ]]; then
            AUDIT_PATH="${DEFAULT_DIR}/${AUDIT_PATH}"
        else
            # Safely convert literal ~/ paths to the invoking user's actual home directory
            # (the RHS must be quoted: an unquoted ~/* would tilde-expand to /root/* and
            # never match a string starting with a literal ~)
            if [[ "$AUDIT_PATH" == "~/"* ]]; then
                AUDIT_PATH="${SUDO_RUNNER_HOME}/${AUDIT_PATH#\~/}"
            elif [[ "$AUDIT_PATH" == "~" ]]; then
                AUDIT_PATH="${SUDO_RUNNER_HOME}"
